# Copy to .env and fill in. Add the same values in Vercel → Settings → Environment Variables.

# Firebase web config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Adzuna API (https://developer.adzuna.com). Server-only — never prefix with VITE_.
# For Firebase Hosting, put these two in functions/.env instead.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

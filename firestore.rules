rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profile docs: only the owner can read or write their own.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Applied jobs: each doc belongs to the user in its userId field.
    match /appliedJobs/{jobId} {
      // resource == null lets the app check whether a job was already saved.
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && jobId.matches(request.auth.uid + '_.+');
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
